---
import DocLayout from "../../layouts/DocLayout.astro";
import Heading from "../../components/docs/Heading.astro";
import ComponentSection from "../../components/docs/ComponentSection.astro";
import ComponentExample from "../../components/docs/ComponentExample.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import PropsTable from "../../components/docs/PropsTable.astro";
import {
  SidebarBasicDemo,
  SidebarToggleDemo,
  SidebarLoadingDemo,
  SidebarScrollToItemDemo,
  SidebarFullDemo,
  SidebarResizableDemo,
  SidebarRightDemo,
  SidebarPeekingDemo,
  SidebarAutoScrollDemo,
  SidebarTransitionCompleteDemo,
  SidebarSlidingViewsDemo,
  SidebarMobileDemo,
  SidebarFullScreenMobileDemo,
} from "../../components/demos/SidebarDemo";
---

<DocLayout
  title="Sidebar"
  description="可组合的侧边栏导航组件，支持可折叠分组、纯图标模式、悬停展开、滑动视图与响应式移动端支持。"
  sourceFile="components/sidebar"
>
  <ComponentSection>
    <ComponentExample code={`<Sidebar.Provider defaultOpen>
  <Sidebar>
    <Sidebar.Content>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Overview</Sidebar.GroupLabel>
        <Sidebar.Menu>
          <Sidebar.MenuButton icon={HouseIcon} active>Home</Sidebar.MenuButton>
          <Sidebar.MenuButton icon={GlobeIcon}>Domains</Sidebar.MenuButton>
        </Sidebar.Menu>
      </Sidebar.Group>
    </Sidebar.Content>
  </Sidebar>
</Sidebar.Provider>`}>
      <SidebarFullDemo client:load />
    </ComponentExample>
  </ComponentSection>

  <ComponentSection>
    <Heading level={2}>安装</Heading>
    <Heading level={3} class="mb-2 text-lg">桶式导出</Heading>
    <CodeBlock code={`import { Sidebar } from "@cloudflare/kumo";`} lang="tsx" />
    <h3 class="mt-4 mb-2 text-lg font-semibold">细粒度导入</h3>
    <CodeBlock code={`import { Sidebar } from "@cloudflare/kumo/components/sidebar";`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <Heading level={2}>用法</Heading>
    <p>
      至少需要 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Provider</code>、
      <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar</code>、
      <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Content</code>（可滚动区域）、
      <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Menu</code> 和
      <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuButton</code>。
      添加 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Header</code> /
      <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Footer</code> 可将内容固定到滚动区域上方或下方。
      使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Group</code> +
      <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">GroupLabel</code> 组织分区。
    </p>
    <CodeBlock code={`import { Sidebar } from "@cloudflare/kumo";
import { HouseIcon, CodeIcon, GearIcon } from "@phosphor-icons/react";

function AppLayout({ children }) {
  return (
    <Sidebar.Provider defaultOpen>
      <Sidebar>
        <Sidebar.Content>
          <Sidebar.Group>
            <Sidebar.GroupLabel>Navigation</Sidebar.GroupLabel>
            <Sidebar.Menu>
              <Sidebar.MenuButton icon={HouseIcon} active>Home</Sidebar.MenuButton>
              {/* MenuItem only needed to wrap Collapsible */}
              <Sidebar.MenuItem>
                <Sidebar.Collapsible>
                  <Sidebar.CollapsibleTrigger
                    render={
                      <Sidebar.MenuButton icon={CodeIcon}>
                        Compute <Sidebar.MenuChevron />
                      </Sidebar.MenuButton>
                    }
                  />
                  <Sidebar.CollapsibleContent>
                    <Sidebar.MenuSub>
                      <Sidebar.MenuSubButton>Workers</Sidebar.MenuSubButton>
                    </Sidebar.MenuSub>
                  </Sidebar.CollapsibleContent>
                </Sidebar.Collapsible>
              </Sidebar.MenuItem>
            </Sidebar.Menu>
          </Sidebar.Group>
        </Sidebar.Content>
        <Sidebar.Footer>
          <Sidebar.Trigger />
        </Sidebar.Footer>
      </Sidebar>
      <div className="flex-1">{children}</div>
    </Sidebar.Provider>
  );
}`} lang="tsx" />
  </ComponentSection>

  <ComponentSection>
    <Heading level={2} class="mb-6">示例</Heading>

    <div class="space-y-8">
      <div>
        <Heading level={3}>基础</Heading>
        <p>
          最小可用的侧边栏：只有分组、菜单按钮与可折叠子菜单，没有页头或页脚。
          <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuButton</code> 和 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuSubButton</code> 会自动包裹在 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">&lt;li&gt;</code> 中 &mdash; 无需 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuItem</code> / <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuSubItem</code>。
        </p>
        <ComponentExample code={`<Sidebar.Provider defaultOpen>
  <Sidebar>
    <Sidebar.Content>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Overview</Sidebar.GroupLabel>
        <Sidebar.Menu>
          <Sidebar.MenuButton icon={HouseIcon} active>Home</Sidebar.MenuButton>
          <Sidebar.MenuButton icon={ChartBarIcon}>Analytics</Sidebar.MenuButton>
        </Sidebar.Menu>
      </Sidebar.Group>
    </Sidebar.Content>
  </Sidebar>
</Sidebar.Provider>`}>
          <SidebarBasicDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>切换与折叠状态</Heading>
        <p>
          在页脚使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.Trigger</code>，或以编程方式调用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">useSidebar().toggleSidebar</code>。折叠时传入 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">tooltip</code>，可在悬停时显示标签。
        </p>
        <ComponentExample code={`<Sidebar.MenuButton icon={HouseIcon} tooltip="Home" active>
  Home
</Sidebar.MenuButton>

<Sidebar.Footer>
  <Sidebar.Trigger />
</Sidebar.Footer>

// Or programmatically:
const { toggleSidebar } = useSidebar();`}>
          <SidebarToggleDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>加载中</Heading>
        <p>
          <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.Loading</code> 在路由与权限解析期间，以导航项目形状的骨架行替代导航内容。折叠时只保留图标方块。遵循 reduced-motion 设置。
        </p>
        <ComponentExample code={`<Sidebar>
  <Sidebar.Header>…</Sidebar.Header>
  {isLoading ? (
    <Sidebar.Loading />
  ) : (
    <Sidebar.Content>…</Sidebar.Content>
  )}
  <Sidebar.Footer>…</Sidebar.Footer>
</Sidebar>`}>
          <SidebarLoadingDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>可调整大小</Heading>
        <p>
          拖拽边缘即可调整大小。拖到低于 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">minWidth</code> 会折叠；从折叠状态向外拖拽会展开。
          调整手柄支持键盘操作：可用方向键、Home 和 End。
        </p>
        <ComponentExample code={`<Sidebar.Provider defaultOpen resizable defaultWidth={240} minWidth={180} maxWidth={400}>
  <Sidebar>
    <Sidebar.Content>...</Sidebar.Content>
    <Sidebar.ResizeHandle />
  </Sidebar>
</Sidebar.Provider>`}>
          <SidebarResizableDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>右侧</Heading>
        <p>
          使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">side="right"</code> 可将侧边栏放在右侧边缘。在 DOM 中应将 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">&lt;Sidebar&gt;</code> 放在 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">&lt;main&gt;</code> 之前。
        </p>
        <ComponentExample code={`<Sidebar.Provider defaultOpen side="right">
  <main className="flex-1">...</main>
  <Sidebar>
    <Sidebar.Content>
      <Sidebar.Group>
        <Sidebar.GroupLabel>Details</Sidebar.GroupLabel>
        <Sidebar.Menu>
          <Sidebar.MenuButton icon={GearIcon} active>Properties</Sidebar.MenuButton>
          <Sidebar.MenuButton icon={ChartBarIcon}>Metrics</Sidebar.MenuButton>
        </Sidebar.Menu>
      </Sidebar.Group>
    </Sidebar.Content>
  </Sidebar>
</Sidebar.Provider>`}>
          <SidebarRightDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>悬停展开</Heading>
        <p>
          在 Provider 上设置 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">peekable</code>。侧边栏折叠时，
          将鼠标悬停或聚焦到它上面会临时展开；移开后又会折叠回去。
          悬停展开期间，<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">data-state</code> 属性会变为 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"peeking"</code>。
        </p>
        <ComponentExample code={`<Sidebar.Provider defaultOpen peekable>
  <Sidebar>
    <Sidebar.Content>...</Sidebar.Content>
    <Sidebar.Footer>
      <Sidebar.Trigger />
    </Sidebar.Footer>
  </Sidebar>
</Sidebar.Provider>

// Read peeking state:
const { state, isPeeking } = useSidebar();
// state: "expanded" | "collapsed" | "peeking"`}>
          <SidebarPeekingDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>自动滚动</Heading>
        <p>
          在较长的可折叠分区上使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">autoScrollOnOpen</code>，可让新展开的内容保持在视线内。
          当可滚动侧边栏底部附近的分组展开到可见区域之外时，这一功能很有用。
        </p>
        <ComponentExample code={`<Sidebar.Collapsible autoScrollOnOpen>
  <Sidebar.CollapsibleTrigger
    render={
      <Sidebar.MenuButton icon={CodeIcon}>
        Workers <Sidebar.MenuChevron />
      </Sidebar.MenuButton>
    }
  />
  <Sidebar.CollapsibleContent>
    <Sidebar.MenuSub>...</Sidebar.MenuSub>
  </Sidebar.CollapsibleContent>
</Sidebar.Collapsible>`}>
          <SidebarAutoScrollDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>过渡完成</Heading>
        <p>
          当某些工作必须等待侧边栏或可折叠分区的过渡结束后才能进行（如测量布局或滚动新展开的内容）时，请使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">onOpenChangeComplete</code>。回调会收到最终的打开状态，并且在 reduced motion 禁用过渡时也会执行。当侧边栏或移动端抽屉显示或隐藏已打开的分区时，<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.Collapsible</code> 也会触发完成回调，因此回调始终与用户所见一致。
        </p>
        <ComponentExample code={`const [completion, setCompletion] = useState("");

<Sidebar.Provider
  defaultOpen
  onOpenChangeComplete={(open) => {
    setCompletion("Sidebar " + (open ? "opened." : "collapsed."));
  }}
>
  <Sidebar>
    <Sidebar.Content>
      <Sidebar.Menu>
        <Sidebar.MenuItem>
          <Sidebar.Collapsible
            onOpenChangeComplete={(open) => {
              setCompletion(
                "Compute section " + (open ? "opened." : "collapsed."),
              );
            }}
          >
            <Sidebar.CollapsibleTrigger render={<Sidebar.MenuButton>Compute</Sidebar.MenuButton>} />
            <Sidebar.CollapsibleContent>...</Sidebar.CollapsibleContent>
          </Sidebar.Collapsible>
        </Sidebar.MenuItem>
      </Sidebar.Menu>
    </Sidebar.Content>
    <Sidebar.Footer><Sidebar.Trigger /></Sidebar.Footer>
  </Sidebar>
</Sidebar.Provider>`}>
          <SidebarTransitionCompleteDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>滚动到指定项目</Heading>
        <p>
          用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">itemId</code> 标记导航项目，然后调用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">useSidebar().scrollToItem(id, options)</code> 将其滚动到视线内。当项目已完全可见时，可用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">scrollItemIntoView(id, options)</code> 保持当前位置不变。<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">align</code> 可取 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"start"</code>、<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"center"</code>、<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"end"</code> 或 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"auto"</code>（默认值，已可见时不做任何操作）。<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">behavior</code> 默认为 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"auto"</code>（即时），这样跨应用落地时不会在进入时播放动画；应用内的「跳转到分区」流程请传入 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">"smooth"</code>。遵循 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">prefers-reduced-motion</code> 设置。与 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.SlidingViews</code> 配合正常 &mdash; 项目来自每个 provider 各自的注册表，而不是通过 DOM 查询解析。
        </p>
        <p>
          <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">itemId</code> 在两种用法下都有效：直接用在 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.MenuButton</code> 上（常见情况，会自动包裹在 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">&lt;li&gt;</code> 中），或当你在 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.MenuItem</code> 中包裹 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Collapsible</code> 时用在其上。即使把 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">itemId</code> 放在嵌套于 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuItem</code> 之内的 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuButton</code> 上，也仍然有效 &mdash; 按钮本身会成为滚动目标。
        </p>
        <ComponentExample code={`<Sidebar.MenuButton itemId="zero-trust" href="/zt">
  Zero Trust
</Sidebar.MenuButton>

// elsewhere:
const { scrollToItem } = useSidebar();
scrollToItem("zero-trust", { align: "center", behavior: "smooth" });`}>
          <SidebarScrollToItemDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>滑动视图</Heading>
        <p>
          使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.SlidingViews</code> 和 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.SlidingView</code>
          可在不同导航界面之间实现带动画的水平过渡（例如账户 &harr; 区域）。
          非活动视图会自动标记 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">aria-hidden</code> 与 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">inert</code>。
          动画遵循 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">prefers-reduced-motion</code> 设置。
        </p>
        <ComponentExample code={`const [surface, setSurface] = useState("account");

<Sidebar.SlidingViews activeKey={surface} direction="left">
  <Sidebar.SlidingView value="account">
    <Sidebar.Content>...account nav...</Sidebar.Content>
  </Sidebar.SlidingView>
  <Sidebar.SlidingView value="zone">
    <Sidebar.Content>...zone nav...</Sidebar.Content>
  </Sidebar.SlidingView>
</Sidebar.SlidingViews>`}>
          <SidebarSlidingViewsDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>完整示例</Heading>
        <p>
          覆盖所有子组件的完整示例：带账户切换器的页头、带标签的分组、含嵌套可展开项的可折叠分区、徽章、滑动视图和页脚触发器。
        </p>
        <ComponentExample code={`<Sidebar>
  <Sidebar.Header>
    <AccountSwitcher />
  </Sidebar.Header>
  <Sidebar.Content>
    <Sidebar.Group>
      <Sidebar.Menu>
        <Sidebar.MenuButton icon={HouseIcon} active>Home</Sidebar.MenuButton>
      </Sidebar.Menu>
    </Sidebar.Group>
    <Sidebar.Group>
      <Sidebar.GroupLabel>Build</Sidebar.GroupLabel>
      <Sidebar.Menu>
        <Sidebar.MenuItem>
          <Sidebar.Collapsible defaultOpen>
            <Sidebar.CollapsibleTrigger
              render={
                <Sidebar.MenuButton icon={CodeIcon}>
                  Compute <Sidebar.MenuChevron />
                </Sidebar.MenuButton>
              }
            />
            <Sidebar.CollapsibleContent>
              <Sidebar.MenuSub>
                <Sidebar.MenuSubButton>
                  Containers <Sidebar.MenuBadge>Beta</Sidebar.MenuBadge>
                </Sidebar.MenuSubButton>
              </Sidebar.MenuSub>
            </Sidebar.CollapsibleContent>
          </Sidebar.Collapsible>
        </Sidebar.MenuItem>
      </Sidebar.Menu>
    </Sidebar.Group>
  </Sidebar.Content>
  <Sidebar.Footer>
    <Sidebar.Trigger />
  </Sidebar.Footer>
</Sidebar>`}>
          <SidebarFullDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>移动端</Heading>
        <p>
          在窄视口下，侧边栏以导航抽屉的形式渲染。使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">mobileBreakpoint</code> 控制阈值。
          抽屉在关闭时使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">inert</code> 与 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">aria-hidden</code>，打开时将焦点移入，并支持按 Escape 关闭。
          此演示通过一个很大的断点值强制进入移动端模式。
        </p>
        <ComponentExample code={`<Sidebar.Provider mobileBreakpoint={9999}>
  <Sidebar>
    <Sidebar.Content>...</Sidebar.Content>
  </Sidebar>
</Sidebar.Provider>`}>
          <SidebarMobileDemo client:load />
        </ComponentExample>
      </div>

      <div>
        <Heading level={3}>移动端全屏</Heading>
        <p>
          传入 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">fullScreenOnMobile</code> 可让抽屉覆盖整个视口，而不在页面边缘留下一小条可见区域。
          导航项目会获得更舒适的触控目标，同时由于面板背后不再显示任何内容，背景遮罩会被隐藏。
          在页头内添加 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Sidebar.Close</code>，即可在导航内部关闭面板。
          与页面页头中的面包屑搭配使用，这样导航关闭后当前路由仍然可见。
        </p>
        <ComponentExample code={`<Sidebar.Provider mobileBreakpoint={9999}>
  <Sidebar fullScreenOnMobile>
    <Sidebar.Header>
      <Sidebar.Close />
    </Sidebar.Header>
    <Sidebar.Content>...</Sidebar.Content>
  </Sidebar>

  <header>
    <Sidebar.Trigger />
    <Breadcrumbs size="sm">
      <Breadcrumbs.Link href="/">Company</Breadcrumbs.Link>
      <Breadcrumbs.Separator />
      <Breadcrumbs.Current>Analytics</Breadcrumbs.Current>
    </Breadcrumbs>
  </header>
</Sidebar.Provider>`}>
          <SidebarFullScreenMobileDemo client:load />
        </ComponentExample>
      </div>

    </div>
  </ComponentSection>

  <ComponentSection>
    <Heading level={2} class="mb-6">API 参考</Heading>

    <div class="space-y-8">
      <div>
        <h3 class="mb-3 text-lg font-semibold font-mono">Sidebar</h3>
        <p>
          侧边栏主容器。在桌面端渲染为 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">&lt;aside&gt;</code>，在移动端渲染为导航抽屉。
        </p>
        <PropsTable component="Sidebar" />
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold font-mono">Sidebar.Provider</h3>
        <p>
          管理展开/折叠状态与移动端检测的上下文 Provider。
        </p>
        <PropsTable component="Sidebar.Provider" />
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold font-mono">Sidebar.Content</h3>
        <p>
          可滚动的中间区域（<code class="rounded bg-kumo-control px-1 py-0.5 text-xs">flex-1 overflow-y-auto</code>）。使用 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Header</code> / <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Footer</code> 可将内容固定到该滚动区域的上方或下方。
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-semibold font-mono">Sidebar.MenuButton</h3>
        <p>
          主要的交互元素。支持图标、激活状态、链接，以及折叠时的自动 tooltip。
          会自动包裹在 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">&lt;li&gt;</code> 中 &mdash; 除非需要包裹 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">Collapsible</code>，否则无需 <code class="rounded bg-kumo-control px-1 py-0.5 text-xs">MenuItem</code> 包装。
        </p>
